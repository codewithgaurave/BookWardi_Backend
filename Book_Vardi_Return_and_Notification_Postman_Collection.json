        },
        {
          "name": "2.2 Create Announcement Notification Bar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"🚀 Flash Sale: 20% OFF on all School Uniforms & Kits!\",\n  \"badge\": \"LIMITED OFFER\",\n  \"link\": \"/offers\",\n  \"priority\": 1,\n  \"isActive\": true,\n  \"bgColor\": \"#1d4ed8\",\n  \"textColor\": \"#ffffff\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/announcements",
              "host": ["{{base_url}}"],
              "path": ["announcements"]
            }
          }
        },
        {
          "name": "2.3 Update Announcement Bar",
