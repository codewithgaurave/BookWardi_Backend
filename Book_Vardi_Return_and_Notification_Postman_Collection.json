{
  "info": {
    "_postman_id": "b37f2a1a-9831-4c12-921d-bookvardi-ret-notif",
    "name": "Book Vardi - Return & Notification API Collection",
    "description": "Postman API Collection for testing Return & Exchange APIs and Announcement/Notification APIs in Book Vardi backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
