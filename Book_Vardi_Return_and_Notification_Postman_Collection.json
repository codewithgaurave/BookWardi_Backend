  "item": [
    {
      "name": "1. Return & Exchange APIs",
      "item": [
        {
          "name": "1.1 Customer Request Return",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "x-user-phone", "value": "9999998888" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"return\",\n  \"reason\": \"Size fits too tight\",\n  \"comment\": \"Fabric quality good but wrong size received.\",\n  \"refundMethod\": \"UPI\",\n  \"refundDetails\": {\n    \"method\": \"UPI\",\n    \"upiId\": \"testcustomer@upi\",\n    \"accountHolderName\": \"Test Customer\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/:id/return-exchange",
              "host": ["{{base_url}}"],
              "path": ["orders", ":id", "return-exchange"],
              "variable": [
                { "key": "id", "value": "6ac0d5644bf70304b7f85040", "description": "Order MongoDB _id or custom orderId" }
              ]
            }
          }
        },
        {
          "name": "1.2 Customer Request Exchange",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "x-user-phone", "value": "9999998888" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"exchange\",\n  \"reason\": \"Size conversion issue\",\n  \"exchangeSize\": \"L\",\n  \"exchangeColor\": \"Navy Blue\",\n  \"comment\": \"Please exchange for Size L\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/:id/return-exchange",
              "host": ["{{base_url}}"],
              "path": ["orders", ":id", "return-exchange"],
              "variable": [
                { "key": "id", "value": "6ac0d5644bf70304b7f85040" }
              ]
            }
          }
        },
        {
