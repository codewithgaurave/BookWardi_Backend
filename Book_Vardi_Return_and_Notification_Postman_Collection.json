            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"🔥 Mega Sale: 25% OFF on all School Uniforms!\",\n  \"badge\": \"UPDATED OFFER\",\n  \"priority\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/announcements/:id",
              "host": ["{{base_url}}"],
              "path": ["announcements", ":id"],
              "variable": [
